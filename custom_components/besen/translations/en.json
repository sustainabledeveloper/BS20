{
  "config": {
    "step": {
      "user": {
        "title": "Add a Besen charger",
        "description": "The serial number is shown in the EVSEMaster app. The password is the charger password, 123456 unless you changed it.",
        "data": {
          "serial": "Serial number",
          "password": "Charger password"
        },
        "data_description": {
          "serial": "16 hexadecimal digits.",
          "password": "Exactly 6 characters."
        }
      },
      "reconfigure": {
        "title": "Change charger settings",
        "data": {
          "serial": "Serial number",
          "password": "Charger password"
        }
      },
      "reauth_confirm": {
        "title": "Charger password",
        "description": "The charger rejected the stored password. Enter the current one.",
        "data": {
          "password": "Charger password"
        }
      },
      "bluetooth_confirm": {
        "title": "Besen charger found over Bluetooth",
        "description": "{name} is advertising nearby. Its serial number ends in {suffix}; enter the whole one, and the charger password.",
        "data": {
          "serial": "Serial number",
          "password": "Charger password"
        }
      }
    },
    "error": {
      "invalid_serial": "The serial number must be 16 hexadecimal digits.",
      "invalid_password": "The charger password must be exactly 6 characters.",
      "serial_mismatch": "That serial number does not end in the digits this charger advertises."
    },
    "abort": {
      "already_configured": "This charger is already set up.",
      "wrong_charger": "That serial number belongs to a different charger.",
      "reauth_successful": "Password updated.",
      "reconfigure_successful": "Settings updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Besen options",
        "data": {
          "ack_charge_records": "Acknowledge uploaded charging records",
          "sync_clock": "Keep the charger's clock in sync",
          "enable_bluetooth": "Reach the charger over Bluetooth when Wi-Fi is down",
          "wifi_ssid": "Wi-Fi network name",
          "wifi_password": "Wi-Fi password",
          "wifi_auto_reprovision": "Re-send Wi-Fi settings automatically",
          "ble_address": "Bluetooth address"
        },
        "data_description": {
          "ack_charge_records": "The charger rebroadcasts each completed session until an app confirms it. Enabling this stops the repeats, but the record may then be dropped before the EVSEMaster app has seen it.",
          "sync_clock": "The charger's clock free-runs and every timestamp it reports depends on it. Home Assistant writes the correct time whenever the charger comes online, which is what the EVSEMaster app does too.",
          "enable_bluetooth": "Some units fail to rejoin Wi-Fi after a power cut. With this on, Home Assistant falls back to Bluetooth once the charger has been silent for two minutes, and releases the link as soon as it is back on the network. Needs a Bluetooth adapter or proxy within range of the charger.",
          "wifi_ssid": "The network the charger should join. Needed only for the repair below.",
          "wifi_password": "Stored with the config entry and redacted from diagnostics. It is written to the charger over Bluetooth, never sent anywhere else.",
          "wifi_auto_reprovision": "When the charger has dropped off the network and Home Assistant reaches it over Bluetooth, write the credentials again -- the repair the phone app performs by hand after a power cut. Runs once per outage.",
          "ble_address": "Leave empty to match by the advertised name. Set it when several chargers share the same last four characters, or when the name is not recognised — the log lists the addresses it can see."
        }
      }
    }
  },
