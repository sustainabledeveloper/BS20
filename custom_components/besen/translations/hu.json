        "data": {
          "ack_charge_records": "Feltöltött töltési rekordok nyugtázása",
          "sync_clock": "A töltő órájának szinkronban tartása",
          "enable_bluetooth": "Bluetooth-kapcsolat, ha a Wi-Fi nem elérhető",
          "wifi_ssid": "Wi-Fi hálózat neve",
          "wifi_password": "Wi-Fi jelszó",
          "wifi_auto_reprovision": "Wi-Fi beállítás automatikus újraküldése",
